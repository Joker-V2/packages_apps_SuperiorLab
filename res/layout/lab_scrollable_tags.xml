<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lab_tags_scrollview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- Row 1: Ignore Secure & Hide Capture -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/toggle_secure_window"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_lab_tag_pill_unselected"
            android:drawableEnd="@drawable/ic_lab_dot_off"
            android:text="@string/lab_quick_secure_off"
            android:textColor="@color/lab_tag_text_unselected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center_vertical|start"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/toggle_hide_capture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_lab_tag_pill_unselected"
            android:drawableEnd="@drawable/ic_lab_dot_off"
            android:text="@string/lab_quick_capture_off"
            android:textColor="@color/lab_tag_text_unselected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center_vertical|start"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Row 2: Heads-Up & Pulse Bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/toggle_heads_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_lab_tag_pill_unselected"
            android:drawableEnd="@drawable/ic_lab_dot_off"
            android:text="@string/lab_quick_headsup_off"
            android:textColor="@color/lab_tag_text_unselected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center_vertical|start"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/toggle_pulse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_lab_tag_pill_unselected"
            android:drawableEnd="@drawable/ic_lab_dot_off"
            android:text="@string/lab_quick_pulse_off"
            android:textColor="@color/lab_tag_text_unselected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center_vertical|start"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
